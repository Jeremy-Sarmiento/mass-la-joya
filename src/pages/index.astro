---
import Layout from '../layouts/Layout.astro';
---

<Layout>


	  <!-- ================= MAIN HEADER & NAVBAR ================= -->
	  <header class="navbar-mass">
	    <div class="container">
	      <div class="row align-items-center g-2">
	        <!-- Logo & Brand -->
	        <div class="col-8 col-md-3">
	          <a href="#inicio" class="mass-brand-container">
	            <img src="assets/img/mass_logo.webp" alt="Logo Mass" class="mass-brand-logo">
	            <div class="mass-brand-text">
	              <span class="mass-brand-title">mass</span>
	              <span class="mass-brand-badge">La Joya</span>
	            </div>
	          </a>
	        </div>

	        <!-- Search Bar with Autocomplete -->
	        <div class="col-12 col-md-5 order-3 order-md-2">
	          <div class="search-wrapper">
	            <input type="text" id="main-search-input" class="search-input" placeholder="Buscar producto en Mass...">
	            <button class="search-btn" type="button" aria-label="Buscar">
	              <i class="fa-solid fa-magnifying-glass"></i>
	            </button>
	            <button id="search-clear-btn" class="btn btn-sm text-muted position-absolute top-50 translate-middle-y p-0" style="display:none; right: 36px; font-size: 0.8rem;" onclick="clearSearch()">
	              <i class="fa-solid fa-xmark"></i>
	            </button>
	            <div id="search-results-dropdown" class="search-dropdown"></div>
	          </div>
	        </div>

	        <!-- Actions & Cart Button -->
	        <div class="col-4 col-md-4 order-2 order-md-3 text-end d-flex align-items-center justify-content-end gap-2">
	          <button class="btn-mass-pill btn-mass-blue d-none d-lg-inline-flex" onclick="openEncarteModal(1)">
	            <i class="fa-solid fa-book-open"></i> Encarte Digital
	          </button>

	          <button type="button" class="btn-mass-pill btn-mass-blue theme-toggle-btn" id="themeToggleBtn" onclick="toggleTheme()" aria-label="Cambiar a modo oscuro">
	            <i class="fa-solid fa-moon"></i>
	          </button>

	          <button class="btn-mass-pill btn-mass-blue cart-btn-wrapper" onclick="openCartDrawer()" aria-label="Ver Carrito">
	            <i class="fa-solid fa-cart-shopping fs-6"></i>
	            <span class="d-none d-sm-inline" id="cart-header-total">S/ 0.00</span>
	            <span class="cart-counter cart-counter-badge" style="display:none;">0</span>
	          </button>
	        </div>
	      </div>
	    </div>

	    <!-- Secondary Links Bar -->
	    <nav class="nav-categories-bar mt-2">
	      <div class="container">
	        <ul class="nav-links-list">
	          <li><a href="#inicio" class="nav-link-item active"><i class="fa-solid fa-house"></i> Inicio</a></li>
	          <li><a href="#seccion-ofertas" class="nav-link-item"><i class="fa-solid fa-tag"></i> Precios Más Mass</a></li>
	          <li><a href="#seccion-catalogo" class="nav-link-item"><i class="fa-solid fa-basket-shopping"></i> Catálogo Completo</a></li>
	          <li><a href="javascript:void(0)" onclick="openEncarteModal(1)" class="nav-link-item"><i class="fa-solid fa-newspaper"></i> Encarte de la Quincena</a></li>
	          <li><a href="#seccion-ubicame" class="nav-link-item"><i class="fa-solid fa-location-dot"></i> Ubícanos en La Joya</a></li>
	          <li><a href="#seccion-fuerza-amarilla" class="nav-link-item"><i class="fa-solid fa-users"></i> Fuerza Amarilla</a></li>
	          <li><a href="#seccion-ofrece-local" class="nav-link-item"><i class="fa-solid fa-store"></i> Ofrece tu Local</a></li>
	          <li><a href="javascript:void(0)" onclick="openModal('myModalPoliticas')" class="nav-link-item"><i class="fa-solid fa-rotate-left"></i> Cambios y Devoluciones</a></li>
	        </ul>
	      </div>
	    </nav>
	  </header>

	  <!-- ================= HERO CAROUSEL ================= -->
	  <section id="inicio" class="hero-section">
	    <div class="container">
	      <div id="heroCarousel" class="carousel slide hero-slider-container" data-bs-ride="carousel" data-bs-interval="4500">
	        <div class="carousel-indicators">
	          <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
	          <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
	          <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
	        </div>

	        <div class="carousel-inner">
	          <div class="carousel-item active">
	            <a href="#seccion-catalogo">
	              <img src="assets/img/banner-hero-1.svg" class="hero-slide-img" alt="¡Los mejores precios en Mass de La Joya!">
	            </a>
	          </div>
	          <div class="carousel-item">
	            <a href="javascript:void(0)" onclick="openEncarteModal(1)">
	              <img src="assets/img/banner-hero-2.svg" class="hero-slide-img" alt="Encarte Digital Mass La Joya">
	            </a>
	          </div>
	          <div class="carousel-item">
	            <a href="javascript:void(0)" onclick="openCartDrawer()">
	              <img src="assets/img/banner-hero-3.svg" class="hero-slide-img" alt="Delivery Express en La Joya">
	            </a>
	          </div>
	        </div>

	        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
	          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
	          <span class="visually-hidden">Anterior</span>
	        </button>
	        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
	          <span class="carousel-control-next-icon" aria-hidden="true"></span>
	          <span class="visually-hidden">Siguiente</span>
	        </button>
	      </div>
	    </div>
	  </section>

	  <!-- ================= BENEFITS STRIP ================= -->
	  <section class="py-4" aria-label="Beneficios y servicios de Mass La Joya">
	    <div class="container">
	      <div class="benefits-strip">
	        <div class="benefit-item">
	          <div class="benefit-icon"><i class="fa-solid fa-truck-fast"></i></div>
	          <div class="benefit-text">
	            <span class="benefit-title">Delivery a domicilio</span>
	            <span class="benefit-sub">Pedidos por WhatsApp</span>
	          </div>
	        </div>
	        <div class="benefit-item">
	          <div class="benefit-icon"><i class="fa-solid fa-mobile-screen-button"></i></div>
	          <div class="benefit-text">
	            <span class="benefit-title">Paga como quieras</span>
	            <span class="benefit-sub">Yape, Plin, efectivo y POS</span>
	          </div>
	        </div>
	        <div class="benefit-item">
	          <div class="benefit-icon"><i class="fa-solid fa-tags"></i></div>
	          <div class="benefit-text">
	            <span class="benefit-title">Precios imbatibles</span>
	            <span class="benefit-sub">Ofertas todos los días</span>
	          </div>
	        </div>
	        <div class="benefit-item">
	          <div class="benefit-icon"><i class="fa-solid fa-clock"></i></div>
	          <div class="benefit-text">
	            <span class="benefit-title">Abierto todos los días</span>
	            <span class="benefit-sub">7:00 a.m. – 10:00 p.m.</span>
	          </div>
	        </div>
	      </div>
	    </div>
	  </section>

	  <!-- ================= CATEGORIES SECTION ================= -->
	  <section class="py-4">
	    <div class="container">
	      <div class="section-title-wrap">
	        <span class="section-badge">Explora por Departamentos</span>
	        <h2 class="section-heading">¿QUÉ ESTÁS BUSCANDO HOY?</h2>
	        <p class="section-subtitle">Selecciona una categoría para filtrar al instante todos los productos disponibles en tu tienda Mass de La Joya.</p>
	      </div>

	      <div class="row g-3" id="category-pills-container">
	        <!-- Rendered dynamically by JavaScript -->
	      </div>
	    </div>
	  </section>

	  <!-- ================= FEATURED: PRECIOS MÁS MASS ================= -->
	  <section id="seccion-ofertas" class="py-5 bg-white">
	    <div class="container">
	      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
	        <div>
	          <span class="section-badge bg-danger text-white">¡Ahorro Máximo Diario!</span>
	          <h2 class="section-heading text-primary">PRECIOS MÁS MASS</h2>
	          <p class="text-muted mb-0">Las mejores ofertas seleccionadas especialmente para los hogares de La Joya.</p>
	        </div>
	        <div class="mt-3 mt-md-0">
	          <a href="#seccion-catalogo" class="btn-mass-pill btn-mass-yellow">
	            Ver todo el catálogo <i class="fa-solid fa-arrow-right"></i>
	          </a>
	        </div>
	      </div>

	      <div class="row g-3" id="featured-products-grid">
	        <!-- Rendered dynamically by JavaScript -->
	      </div>
	    </div>
	  </section>

	  <!-- ================= BANNER CATALOGO PROMO ================= -->
	  <section class="py-5">
	    <div class="container">
	      <div class="banner-catalogo-section">
	        <div class="row align-items-center">
	          <div class="col-12 col-lg-7 text-center text-lg-start mb-4 mb-lg-0">
	            <span class="badge bg-primary text-warning px-3 py-2 rounded-pill fw-bold mb-2">¡EXCLUSIVO LA JOYA!</span>
	            <h2>¡LOS MEJORES PRECIOS DEL BARRIO!</h2>
	            <p>Caser@, a mí nadie me gana: tengo siempre los <strong>precios más bajos</strong> de Arequipa y, además, estoy <strong>cerquita de tu hogar</strong> en el corazón de La Joya.</p>
	            <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
	              <button class="btn-mass-pill btn-mass-blue fs-6" onclick="openEncarteModal(1)">
	                <i class="fa-solid fa-book-open"></i> Ver Encarte Digital
	              </button>
	              <a href="https://wa.me/51997833866?text=Hola%20Mass%20La%20Joya,%20quiero%20hacer%20un%20pedido" target="_blank" class="btn-mass-pill btn-mass-red fs-6">
	                <i class="fa-brands fa-whatsapp"></i> Pedir por WhatsApp
	              </a>
	            </div>
	          </div>
	          <div class="col-12 col-lg-5 text-center">
	            <img src="assets/img/mano-catalogos.webp" alt="Catálogo Mass" class="img-fluid" style="max-height: 280px;">
	          </div>
	        </div>
	      </div>
	    </div>
	  </section>

	  <!-- ================= FULL PRODUCT CATALOG SECTION ================= -->
	  <section id="seccion-catalogo" class="py-5 bg-light">
	    <div class="container">
	      <div class="section-title-wrap">
	        <span class="section-badge">Catálogo en Vivo</span>
	        <h2 class="section-heading">TODOS LOS PRODUCTOS MASS</h2>
	        <p class="section-subtitle" id="products-count-label">Cargando productos de Mass de La Joya...</p>
	      </div>

	      <!-- Controls: Zone, Sort, Search Filters -->
	      <div class="p-3 bg-white rounded-4 shadow-sm border mb-4">
	        <div class="row g-3 align-items-center">
	          <div class="col-12 col-md-5">
	            <div class="d-flex align-items-center gap-2">
	              <span class="text-primary fw-bold small text-nowrap"><i class="fa-solid fa-location-dot"></i> Entrega:</span>
	              <select class="form-select form-select-sm delivery-zone-select rounded-pill border-primary">
	                <!-- Populated dynamically -->
	              </select>
	            </div>
	          </div>

	          <div class="col-6 col-md-4">
	            <div class="d-flex align-items-center gap-2">
	              <span class="text-muted small text-nowrap"><i class="fa-solid fa-arrow-down-short-wide"></i> Ordenar:</span>
	              <select id="sort-products-select" class="form-select form-select-sm rounded-pill">
	                <option value="default">Recomendados</option>
	                <option value="price-asc">Precio: Menor a Mayor</option>
	                <option value="price-desc">Precio: Mayor a Menor</option>
	                <option value="discount">Mayor Descuento %</option>
	                <option value="name">Nombre A-Z</option>
	              </select>
	            </div>
	          </div>

	          <div class="col-6 col-md-3 text-end">
	            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="resetFilters()">
	              <i class="fa-solid fa-filter-circle-xmark"></i> Limpiar Filtros
	            </button>
	          </div>
	        </div>
	      </div>

	      <!-- Product Grid -->
	      <div class="row g-3" id="products-grid">
	        <!-- Rendered dynamically by JavaScript -->
	      </div>
	    </div>
	  </section>

	  <!-- ================= DIGITAL ENCARTE PROMO BANNER ================= -->
	  <section class="py-5 bg-primary text-white text-center position-relative overflow-hidden">
	    <div class="container position-relative" style="z-index: 2;">
	      <span class="badge bg-warning text-primary px-3 py-2 rounded-pill fw-bold mb-2">ENCARTE QUINCENAL</span>
	      <h2 class="display-6 fw-bold mb-3">¿Prefieres hojear nuestro folleto de ofertas?</h2>
	      <p class="lead text-light mb-4" style="max-width: 650px; margin: 0 auto;">
	        Descubre las 3 páginas interactivas de nuestro encarte oficial para La Joya. Puedes hacer clic en los productos para agregarlos directamente a tu pedido.
	      </p>
	      <button class="btn-mass-pill btn-mass-yellow fs-5 px-4 py-3" onclick="openEncarteModal(1)">
	        <i class="fa-solid fa-book-open-reader"></i> Abrir Encarte Interactivo
	      </button>
	    </div>
	  </section>

	  <!-- ================= STORE LOCATOR: LA JOYA ================= -->
	  <section id="seccion-ubicame" class="py-5 bg-white">
	    <div class="container">
	      <div class="section-title-wrap">
	        <span class="section-badge">Visítanos en persona</span>
	        <h2 class="section-heading">UBÍCAME EN LA JOYA - AREQUIPA</h2>
	        <p class="section-subtitle">Estamos ubicados en una zona céntrica y de fácil acceso para todos los vecinos joyeros.</p>
	      </div>

	      <div class="store-locator-card">
	        <div class="row g-0">
	          <div class="col-12 col-lg-5 store-info-box">
	            <div class="store-badge-live mb-3">
	              Abierto ahora mismo
	            </div>
	            <h3 class="text-primary fw-bold mb-2">Tienda Mass La Joya</h3>
	            <p class="text-muted mb-4"><i class="fa-solid fa-location-dot text-danger"></i> Av. Paz Soldán, La Joya, Arequipa, Perú.</p>

	            <div class="mb-3">
	              <h6 class="fw-bold text-dark mb-1"><i class="fa-regular fa-clock text-primary"></i> Horario de Atención:</h6>
	              <p class="text-secondary small mb-0">Lunes a Domingo (incluyendo feriados): <strong>7:00 AM - 10:00 PM</strong></p>
	            </div>

	            <div class="mb-3">
	              <h6 class="fw-bold text-dark mb-1"><i class="fa-solid fa-phone text-success"></i> Central y WhatsApp:</h6>
	              <p class="text-secondary small mb-0">+51 997 833 866</p>
	            </div>

	            <div class="mb-4">
	              <h6 class="fw-bold text-dark mb-1"><i class="fa-solid fa-credit-card text-info"></i> Servicios Disponibles:</h6>
	              <div class="d-flex flex-wrap gap-1 mt-1">
	                <span class="badge bg-light text-dark border">Yape & Plin</span>
	                <span class="badge bg-light text-dark border">POS Visa & Mastercard</span>
	                <span class="badge bg-light text-dark border">Agente Corresponsal</span>
	                <span class="badge bg-light text-dark border">Recargas Móviles</span>
	                <span class="badge bg-light text-dark border">Estacionamiento</span>
	              </div>
	            </div>

	            <div class="d-flex flex-wrap gap-2">
	              <a href="https://maps.app.goo.gl/L1dAmB6dL8NKLfm97" target="_blank" class="btn-mass-pill btn-mass-blue">
	                <i class="fa-solid fa-diamond-turn-right"></i> Abrir en Google Maps
	              </a>
	              <a href="https://wa.me/51997833866?text=Hola%20Mass%20La%20Joya,%20tengo%20una%20consulta" target="_blank" class="btn-mass-pill btn-mass-yellow">
	                <i class="fa-brands fa-whatsapp"></i> Escribir a Tienda
	              </a>
	            </div>
	          </div>

	          <!-- Mapa Interactivo en Tiempo Real -->
	          <div class="col-12 col-lg-7 p-3 bg-light">
	            <div class="footer-map h-100">
	              <div class="d-flex justify-content-between align-items-center mb-2">
	                <h3 class="footer-map-title h5 text-primary fw-bold m-0"><i class="fa-solid fa-map-location-dot me-1"></i> Ubicación Tienda Mass La Joya</h3>
	                <a href="https://maps.app.goo.gl/L1dAmB6dL8NKLfm97" target="_blank" class="badge bg-primary text-warning text-decoration-none">
	                  <i class="fa-solid fa-arrow-up-right-from-square"></i> Ver en Maps
	                </a>
	              </div>
	              <iframe
	                class="mapa-embed rounded-4 shadow-sm w-100"
	                src="https://www.openstreetmap.org/export/embed.html?bbox=-71.8285%2C-16.4295%2C-71.8140%2C-16.4215&layer=mapnik&marker=-16.4256223%2C-71.8212998"
	                height="360"
	                style="border:0;"
	                allowfullscreen=""
	                loading="lazy"
	                title="Mapa de la tienda Mass de La Joya"></iframe>
	            </div>
	          </div>
	        </div>
	      </div>
	    </div>
	  </section>

	  <!-- ================= FUERZA AMARILLA (TRABAJA CON NOSOTROS) ================= -->
	  <section id="seccion-fuerza-amarilla" class="py-5">
	    <div class="container">
	      <div class="fuerza-amarilla-section">
	        <div class="row align-items-center">
	          <div class="col-12 col-lg-7 mb-4 mb-lg-0">
	            <img src="assets/img/fuerza-amarilla.png" alt="Fuerza Amarilla Mass" class="img-fluid mb-3" style="max-height: 90px;">
	            <h2 class="fw-bold text-primary display-6 mb-3">¡ÚNETE A LA FUERZA AMARILLA EN LA JOYA!</h2>
	            <p class="lead fw-semibold text-dark mb-2">¡Tú pones el talento y juntos desarrollamos tu potencial!</p>
	            <p class="text-dark mb-4">
	              Si tienes 18 años a más, vives en La Joya o distritos aledaños, te apasiona la atención al cliente y buscas estabilidad con beneficios de ley, ingreso a planilla desde el primer día y capacitaciones continuas... ¡te estamos buscando!
	            </p>
	            <button class="btn-mass-pill btn-mass-blue fs-6" onclick="openModal('trabajaModal')">
	              <i class="fa-solid fa-user-plus"></i> Postular Ahora en La Joya
	            </button>
	          </div>
	          <div class="col-12 col-lg-5 text-center">
	            <img src="assets/img/trabajo.webp" alt="Trabaja en Tiendas Mass" class="img-fluid rounded-4 shadow-sm" style="max-height: 320px;">
	          </div>
	        </div>
	      </div>
	    </div>
	  </section>

	  <!-- ================= OFRECE TU LOCAL ================= -->
	  <section id="seccion-ofrece-local" class="py-5 bg-white">
	    <div class="container">
	      <div class="p-4 p-md-5 bg-light rounded-4 border shadow-sm">
	        <div class="row align-items-center">
	          <div class="col-12 col-lg-6 mb-4 mb-lg-0">
	            <span class="badge bg-primary text-warning px-3 py-2 rounded-pill fw-bold mb-2">EXPANSIÓN MASS</span>
	            <h2 class="text-primary fw-bold mb-3">¿TIENES UN LOCAL EN ALQUILER EN LA JOYA?</h2>
	            <p class="text-secondary mb-3">
	              En Tiendas Mass buscamos locales comerciales para seguir abriendo nuevas sedes más cerca de las familias joyeras.
	            </p>
	            <ul class="text-secondary small ps-3 mb-4">
	              <li class="mb-1">Área mínima requerida: <strong>120 m² a 300 m²</strong> en primer piso.</li>
	              <li class="mb-1">Frente comercial mínimo de <strong>6 metros lineales</strong>.</li>
	              <li class="mb-1">Ubicación en avenidas principales, zonas comerciales o de alto tránsito peatonal.</li>
	              <li>Contratos a largo plazo con garantía y puntualidad de pago de Supermercados Peruanos.</li>
	            </ul>
	            <button class="btn-mass-pill btn-mass-yellow" onclick="openModal('ofreceLocalModal')">
	              <i class="fa-solid fa-building"></i> Registrar mi Local
	            </button>
	          </div>

	          <div class="col-12 col-lg-6">
	            <div class="bg-white p-4 rounded-4 shadow-sm border">
	              <h5 class="text-primary fw-bold mb-3"><i class="fa-solid fa-paper-plane"></i> Envíanos los datos de tu inmueble</h5>
	              <form id="ofrece-local-form" onsubmit="submitLocalOffer(event)">
	                <div class="mb-2">
	                  <label class="form-label small fw-bold">Nombre del Propietario / Contacto:</label>
	                  <input type="text" class="form-control form-control-sm" required placeholder="Ej: Juan Pérez">
	                </div>
	                <div class="row g-2 mb-2">
	                  <div class="col-6">
	                    <label class="form-label small fw-bold">Teléfono / Celular:</label>
	                    <input type="tel" class="form-control form-control-sm" required placeholder="987654321">
	                  </div>
	                  <div class="col-6">
	                    <label class="form-label small fw-bold">Área aprox (m²):</label>
	                    <input type="number" class="form-control form-control-sm" required placeholder="Ej: 180">
	                  </div>
	                </div>
	                <div class="mb-3">
	                  <label class="form-label small fw-bold">Dirección en La Joya:</label>
	                  <input type="text" class="form-control form-control-sm" required placeholder="Ej: Av. Panamericana Sur Km 980">
	                </div>
	                <button type="submit" class="btn-mass-pill btn-mass-blue w-100">
	                  Enviar Propuesta de Local
	                </button>
	              </form>
	            </div>
	          </div>
	        </div>
	      </div>
	    </div>
	  </section>

	  <!-- ================= TESTIMONIALS OF CASER@S ================= -->
	  <section class="py-5 bg-light">
	    <div class="container">
	      <div class="section-title-wrap">
	        <span class="section-badge">La opinión de nuestros vecinos</span>
	        <h2 class="section-heading">LO QUE DICEN NUESTROS CASER@S</h2>
	        <p class="section-subtitle">Familias de La Joya que disfrutan de precios bajos todos los días.</p>
	      </div>

	      <div class="row" id="testimonials-container">
	        <!-- Rendered dynamically by JavaScript -->
	      </div>
	    </div>
	  </section>

	  <!-- ================= FOOTER ================= -->
	  <footer>
	    <div class="container">
	      <!-- Métodos de Pago -->
	      <div class="text-center mb-5">
	        <h4 class="footer-heading mb-3">MÉTODOS DE PAGO ACEPTADOS</h4>
	        <img src="assets/img/metodos-pago.png" alt="Métodos de pago en Tiendas Mass" class="img-fluid" style="max-height: 48px;">
	      </div>

	      <div class="row g-4 mb-4">
	        <!-- About Mass La Joya -->
