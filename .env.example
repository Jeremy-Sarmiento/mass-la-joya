# Entorno de la aplicación
APP_ENV=local
APP_DEBUG=true

# URL pública absoluta (opcional). Si se deja vacía se deduce de la petición.
# APP_URL=https://jeremy-sarmiento.github.io/mass-la-joya

# Meta Pixel (Facebook / Meta Ads). Sin valor, el píxel y el aviso de cookies no se cargan.
META_PIXEL_ID=

# Número de WhatsApp de la tienda, formato internacional sin "+".
STORE_WHATSAPP=51997833866

# Directorio de datos (opcional). Por defecto: ./storage
# STORAGE_PATH=/ruta/absoluta/a/storage
